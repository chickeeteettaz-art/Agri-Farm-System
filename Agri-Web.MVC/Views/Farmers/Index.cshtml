@model IEnumerable<ClassLibrary.Data.Farmer>

@{
    ViewData["Title"] = "Farmers";
}

<div class="container-fluid py-4">

    <h2 class="fw-bold mb-4">Farmer Management</h2>

    <div class="card border-0 shadow-sm">
        <div class="card-body">

            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Farmer ID</th>
                            <th>Username</th>
                            <th>Farm Name</th>
                            <th>Role</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var farmer in Model)
                        {
                            <tr>
                                <td>@farmer.FarmerId</td>
                                <td>@farmer.Username</td>
                                <td>@farmer.FarmName</td>
                                <td>
                                    <span class="badge bg-success">
                                        @farmer.Role
                                    </span>
                                </td>
                                <td>
                                    <a asp-action="Details"
                                       asp-route-id="@farmer.FarmerId"
                                       class="btn btn-sm btn-outline-primary">
                                        View
                                    </a>

                                    <form asp-action="Delete"
                                          asp-route-id="@farmer.FarmerId"
                                          method="post"
                                          class="d-inline">
                                        @Html.AntiForgeryToken()

                                        <button type="submit"
                                                class="btn btn-sm btn-outline-danger"
                                                onclick="return confirm('Delete this farmer?');">
                                            Delete
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

        </div>
    </div>
</div>