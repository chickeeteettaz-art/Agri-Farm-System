@model ClassLibrary.Data.Device

@{
    ViewData["Title"] = "Register Device";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-7">

            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">

                    <h3 class="fw-bold mb-4">Register IoT Device</h3>

                    <form asp-action="Create" method="post">
                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger"></div>

                        <div class="mb-3">
                            <label asp-for="DeviceName"
                                   class="form-label"></label>
                            <input asp-for="DeviceName"
                                   class="form-control" />
                            <span asp-validation-for="DeviceName"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="DeviceType"
                                   class="form-label"></label>
                            <select asp-for="DeviceType"
                                    class="form-select">
                                <option value="">Select device type</option>
                                <option value="Soil Moisture Sensor">
                                    Soil Moisture Sensor
                                </option>
                                <option value="Temperature Sensor">
                                    Temperature Sensor
                                </option>
                                <option value="pH Sensor">
                                    pH Sensor
                                </option>
                                <option value="Irrigation Controller">
                                    Irrigation Controller
                                </option>
                            </select>
                            <span asp-validation-for="DeviceType"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="FarmName"
                                   class="form-label"></label>
                            <input asp-for="FarmName"
                                   class="form-control" />
                            <span asp-validation-for="FarmName"
                                  class="text-danger"></span>
                        </div>

                        <button type="submit" class="btn btn-success">
                            Register Device
                        </button>

                        <a asp-action="Index"
                           class="btn btn-outline-secondary">
                            Cancel
                        </a>
                    </form>

                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}