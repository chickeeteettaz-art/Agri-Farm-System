
@model Agri_Web.MVC.Models.IrrigationResultViewModel

@{
    ViewData["Title"] = "Irrigation Command Result";
}

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-lg-7">

            <div class="card border-0 shadow-sm">

                <div class="card-body text-center p-5">

                    <i class="bi bi-check-circle-fill text-success"
                       style="font-size: 4rem;"></i>

                    <h2 class="fw-bold mt-3">
                        Command Response
                    </h2>

                    <p class="text-muted">
                        @Model.Message
                    </p>

                    <hr />

                    <div class="text-start">

                        <div class="d-flex justify-content-between mb-3">
                            <span class="text-muted">Command ID</span>
                            <strong>@Model.CommandId</strong>
                        </div>

                        <div class="d-flex justify-content-between mb-3">
                            <span class="text-muted">Device</span>
                            <strong>@Model.DeviceId</strong>
                        </div>

                        <div class="d-flex justify-content-between mb-3">
                            <span class="text-muted">Command</span>
                            <strong>@Model.Command</strong>
                        </div>

                        <div class="d-flex justify-content-between">
                            <span class="text-muted">Status</span>

                            <span class="badge
                                @(Model.Status == "Pending"
                                    ? "bg-warning text-dark"
                                    : "bg-success")">
                                @Model.Status
                            </span>
                        </div>

                    </div>

                    <div class="alert alert-info text-start mt-4">
                        A successful queue response means that the command
                        was accepted for processing. It does not confirm
                        that the irrigation hardware has executed it.
                    </div>

                    <a asp-controller="Irrigation"
                       asp-action="Index"
                       class="btn btn-success mt-3">
                        Back to Irrigation Management
                    </a>

                </div>

            </div>

        </div>

    </div>

</div>
