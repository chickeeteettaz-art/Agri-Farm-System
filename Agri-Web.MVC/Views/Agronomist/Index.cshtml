@model IEnumerable<ClassLibrary.Data.Agronomist>

@{
    ViewData["Title"] = "Agronomists";
}

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold">Agronomist Management</h2>

        <a asp-action="Create" class="btn btn-success">
            <i class="bi bi-person-plus"></i> Add Agronomist
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    <div class="card border-0 shadow-sm">
        <div class="card-body table-responsive">

            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Username</th>
                        <th>Role</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.AgronomistId</td>
                            <td>@item.Username</td>
                            <td><span class="badge bg-info">@item.Role</span></td>
                            <td>
                                <a asp-action="Edit"
                                   asp-route-id="@item.AgronomistId"
                                   class="btn btn-sm btn-outline-primary">
                                    Edit
                                </a>

                                <form asp-action="Delete"
                                      asp-route-id="@item.AgronomistId"
                                      method="post"
                                      class="d-inline">
                                    @Html.AntiForgeryToken()

                                    <button class="btn btn-sm btn-outline-danger"
                                            onclick="return confirm('Delete this account?');">
                                        Delete
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

        </div>
    </div>
</div>