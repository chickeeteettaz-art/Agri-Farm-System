
@model List<string>

@{
    ViewData["Title"] = "Drone Images";
    var farmName = ViewBag.FarmName as string ?? "Farm001";
}

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold">Drone Images</h2>
            <p class="text-muted mb-0">
                Manage aerial images uploaded for @farmName.
            </p>
        </div>

        <a asp-action="Upload"
           asp-route-farmName="@farmName"
           class="btn btn-success">
            <i class="bi bi-cloud-upload"></i>
            Upload Image
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
            @if (TempData["BlobPath"] != null)
            {
                <div class="small mt-1">
                    Blob path: @TempData["BlobPath"]
                </div>
            }
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white py-3">
            <h5 class="mb-0">Uploaded Image Files</h5>
        </div>

        <div class="card-body">
            @if (Model == null || !Model.Any())
            {
                <div class="text-center py-5">
                    <i class="bi bi-images display-3 text-muted"></i>
                    <h5 class="mt-3">No images found</h5>
                    <p class="text-muted">
                        Upload a drone image to get started.
                    </p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead>
                            <tr>
                                <th>Image Name</th>
                                <th>Blob Path</th>
                                <th class="text-end">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var image in Model)
                            {
                                var imageName = System.IO.Path.GetFileName(image);

                                <tr>
                                    <td>
                                        <i class="bi bi-file-image text-success me-2"></i>
                                        @imageName
                                    </td>
                                    <td class="text-muted">@image</td>
                                    <td class="text-end">
                                        <form asp-action="Delete"
                                              method="post"
                                              class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden"
                                                   name="farmName"
                                                   value="@farmName" />
                                            <input type="hidden"
                                                   name="imageName"
                                                   value="@imageName" />

                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-danger"
                                                    onclick="return confirm('Delete this image?');">
                                                <i class="bi bi-trash"></i>
                                                Delete
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
