@model List<string>

@{
    ViewData["Title"] = "Drone Images";

    var farmName = ViewBag.FarmName as string ?? "Farm001";
}

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold">
                <i class="bi bi-camera text-success"></i>
                Drone Images
            </h2>

            <p class="text-muted">
                View and manage aerial images uploaded for @farmName.
            </p>
        </div>

        <a asp-action="Upload"
           asp-route-farmName="@farmName"
           class="btn btn-success">
            <i class="bi bi-cloud-upload"></i>
            Upload New Image
        </a>

    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger">
            @ViewBag.ErrorMessage
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center py-5">

                <i class="bi bi-images display-1 text-muted"></i>

                <h4 class="mt-3">No Drone Images Found</h4>

                <p class="text-muted">
                    There are currently no uploaded images for this farm.
                </p>

                <a asp-action="Upload"
                   asp-route-farmName="@farmName"
                   class="btn btn-success">
                    Upload First Image
                </a>

            </div>
        </div>
    }
    else
    {
        <div class="row g-4">

            @foreach (var image in Model)
            {
                var imageName =
                    System.IO.Path.GetFileName(image);

                <div class="col-sm-6 col-md-4 col-lg-3">

                    <div class="card border-0 shadow-sm h-100">

                        <div class="overflow-hidden"
                             style="height:220px; background:#f1f3f5;">

                            <img src="@Url.Action(
                                                                     "Image",
                                                                     "DroneImages",
                                                                     new
                                                                     {
                                                                         farmName = farmName,
                                                                         imageName = imageName
                                                                     })"
                                 alt="@imageName"
                                 class="w-100 h-100"
                                 style="object-fit:cover;"
                                 loading="lazy"
                                 onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />

                            <div class="w-100 h-100 align-items-center justify-content-center text-muted"
                                 style="display:none;">
                                <div class="text-center">
                                    <i class="bi bi-image display-4"></i>
                                    <p>Image unavailable</p>
                                </div>
                            </div>

                        </div>

                        <div class="card-body">

                            <h6 class="fw-semibold text-truncate"
                                title="@imageName">
                                @imageName
                            </h6>

                            <p class="text-muted small mb-3">
                                Farm: @farmName
                            </p>

                            <form asp-action="Delete"
                                  method="post">

                                @Html.AntiForgeryToken()

                                <input type="hidden"
                                       name="farmName"
                                       value="@farmName" />

                                <input type="hidden"
                                       name="imageName"
                                       value="@imageName" />

                                <button type="submit"
                                        class="btn btn-outline-danger btn-sm w-100"
                                        onclick="return confirm('Are you sure you want to delete this image?');">

                                    <i class="bi bi-trash"></i>
                                    Delete Image

                                </button>

                            </form>

                        </div>

                    </div>

                </div>
            }

        </div>
    }

</div>
